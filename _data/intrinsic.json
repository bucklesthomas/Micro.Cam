 "notes": {
  "Acinetobacter baumannii": "May test susceptible to ampicillin–sulbactam because sulbactam itself is active. Resistant to tetracycline and doxycycline; minocycline and tigecycline vary.",
  "Stenotrophomonas maltophilia": "Usually susceptible to co-trimoxazole but resistant to trimethoprim alone. Resistant to all aminoglycosides and to carbapenems (L1 metallo-β-lactamase). Doxycycline, minocycline and tigecycline vary.",
  "Burkholderia cepacia": "Some strains look β-lactam susceptible in vitro but are clinically resistant. Resistant to all aminoglycosides and colistin.",
  "Pseudomonas aeruginosa": "Also resistant to kanamycin and neomycin.",
  "Enterococcus faecalis": "Low-level aminoglycoside resistance is expected; gentamicin can still be synergistic with a penicillin or glycopeptide unless there is high-level resistance (HLAR).",
  "Enterococcus faecium": "Low-level aminoglycoside resistance plus AAC(6′)-I: no synergy with aminoglycosides other than gentamicin, amikacin and streptomycin.",
  "Enterococcus gallinarum": "VanC: low-level vancomycin resistance (teicoplanin usually active).",
  "Enterococcus casseliflavus": "VanC: low-level vancomycin resistance (teicoplanin usually active).",
  "Serratia marcescens": "Intrinsically resistant to colistin and nitrofurantoin.",
  "Proteus mirabilis": "Intrinsically resistant to colistin, nitrofurantoin and tetracyclines (including tigecycline).",
  "Morganella morganii": "Intrinsically resistant to colistin, nitrofurantoin and tetracyclines.",
  "Listeria monocytogenes": "All cephalosporins are inactive: use amoxicillin.",
  "Leuconostoc mesenteroides": "Intrinsically vancomycin resistant.",
  "Pediococcus acidilactici": "Intrinsically vancomycin resistant.",
  "Lacticaseibacillus rhamnosus": "Intrinsically vancomycin resistant (L. casei group).",
  "Staphylococcus saprophyticus": "Also resistant to fosfomycin and fusidic acid.",
  "Elizabethkingia meningoseptica": "Carbapenem resistant (two metallo-β-lactamases); often susceptible to agents usually used for Gram-positives (e.g. rifampicin, vancomycin) despite the table: seek microbiology advice.",
  "Clostridium innocuum": "Intrinsically low-level vancomycin resistant.",
  "Thomasclavelia ramosa": "Formerly Clostridium ramosum. Intrinsically vancomycin resistant.",
  "Bacteroides fragilis group": "All anaerobes are intrinsically resistant to aminoglycosides. Acquired resistance to clindamycin, and increasingly to carbapenems and metronidazole, also occurs."
 },
 "ampc": {
